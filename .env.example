# Postgres (Docker)
POSTGRES_USER=chaos
POSTGRES_PASSWORD=chaos
POSTGRES_DB=chaos

# CORS — oddělené čárkou (stejný origin přes nginx obvykle stačí)
CORS_ORIGINS=https://chaos.propoj.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Lokální debug port web kontejneru (HTTPS/doménu řeší Traefik)
CHAOS_PORT=8080
