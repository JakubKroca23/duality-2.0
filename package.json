{
  "name": "chaos-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev -w @duality/api",
    "dev:db": "docker compose up db -d",
    "build": "tsc && vite build",
    "build:api": "npm run build -w @duality/api",
    "preview": "vite preview",
    "docker:up": "docker compose up --build -d",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web api"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
